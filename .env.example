# ─────────────────────────────────────────────────────────────────────────────
# Aloqa kabel reyestri — Docker Compose va Laravel uchun yagona .env
#   cp .env.example .env    → keyin APP_KEY va parollarni o'zgartiring
# .env faylini hech qachon Git'ga qo'shmang.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ilova ────────────────────────────────────────────────────────────────────
APP_NAME="Aloqa kabel reyestri"
# local | production
APP_ENV=local
# Production'da albatta false (entrypoint aks holda ishga tushmaydi)
APP_DEBUG=true
# Yaratish: docker compose run --rm backend php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8090
APP_TIMEZONE=Asia/Tashkent
APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uz_UZ

# Nginx tashqi porti. Faqat lokal kirish uchun APP_BIND=127.0.0.1
APP_PORT=8090
APP_BIND=0.0.0.0

# Konteyner ishga tushganda migratsiyalarni avtomatik bajarish
RUN_MIGRATIONS=true

# ── Ma'lumotlar bazasi (MySQL 8.4) ───────────────────────────────────────────
# Faqat LOCAL development uchun: root/root.
# PRODUCTION: alohida cheklangan foydalanuvchi va kamida 16 belgili kuchli parol
#   DB_USERNAME=aloqa_app  DB_PASSWORD=<kuchli-parol>  DB_ROOT_PASSWORD=<boshqa-kuchli-parol>
DB_CONNECTION=mysql
DB_DATABASE=aloqa
DB_USERNAME=root
DB_PASSWORD=root
DB_ROOT_PASSWORD=root
# Dev rejimida host'dan ulanish porti (faqat 127.0.0.1)
DB_FORWARD_PORT=33070

# ── Sessiya / SPA autentifikatsiya (Sanctum, cookie asosida) ─────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS ortida ishlaganda true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Brauzerda ochiladigan host:port ro'yxati (vergul bilan). localhost:517x — hostdagi `npm run dev` uchun;
# production'da faqat haqiqiy domen qoldirilsin (masalan, aloqa.urtg.uz)
SANCTUM_STATEFUL_DOMAINS=localhost:8090,127.0.0.1:8090,localhost:5173,localhost:5174,127.0.0.1:5173,aloqa.urtg.uz
# Boshqa domenlardan API ga ruxsat (vergul bilan). Bo'sh bo'lsa faqat APP_URL
CORS_ALLOWED_ORIGINS=

# ── Navbat, kesh, log ────────────────────────────────────────────────────────
QUEUE_CONNECTION=database
CACHE_STORE=database
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=info
BCRYPT_ROUNDS=12
FILESYSTEM_DISK=local
MAIL_MAILER=log

# ── Xarita provayderi (OSM siyosatiga rioya qiling; yuqori yuklamada o'z tile serveringiz) ──
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> mualliflari"
MAP_MAX_ZOOM=19
MAP_DEFAULT_LAT=41.5500
MAP_DEFAULT_LNG=60.6300
MAP_DEFAULT_ZOOM=8
# Sun'iy yo'ldosh qatlami (bo'sh URL — qatlam ko'rsatilmaydi). Esri World Imagery standart qiymat; production uchun
# litsenziyalangan yoki korporativ tasvir provayderini ulang. MAX_NATIVE_ZOOM dan yaqinroqda tasvir kattalashtiriladi.
MAP_SATELLITE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
MAP_SATELLITE_ATTRIBUTION="Tasvirlar &copy; <a href=\"https://www.esri.com\">Esri</a>, Maxar, Earthstar Geographics"
MAP_SATELLITE_MAX_NATIVE_ZOOM=18
MAP_SATELLITE_LABELS_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}

# ── Biznes qoidalari ─────────────────────────────────────────────────────────
# Uzunlik farqi chegarasi: |farq| > max(LENGTH_TOLERANCE_M, uzunlik * PERCENT/100) bo'lsa sabab va hujjat talab qilinadi
LENGTH_TOLERANCE_M=5
LENGTH_TOLERANCE_PERCENT=2
# Material miqdori farqi chegarasi (%)
MATERIAL_TOLERANCE_PERCENT=1
# Rangli metall (Al, Pb, Cu) massalari farqi chegarasi (%), standart qiymat — Sozlamalarda o'zgartiriladi
METAL_TOLERANCE_PERCENT=3
# Yuklanadigan fayl maksimal hajmi (KB)
DOCUMENT_MAX_KB=51200
